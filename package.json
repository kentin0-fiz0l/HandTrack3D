{
  "name": "handtrack3d",
  "version": "0.4.0-alpha.0",
  "description": "Extensible plugin platform for 3D hand interaction with WiFi positioning and sensor fusion",
  "keywords": [
    "hand-tracking",
    "mediapipe",
    "three-js",
    "gesture-recognition",
    "3d-interaction",
    "computer-vision",
    "webgl",
    "react",
    "typescript",
    "wifi-positioning",
    "sensor-fusion",
    "kalman-filter",
    "spatial-computing",
    "room-scale",
    "plugin-system"
  ],
  "homepage": "https://kentin0-fiz0l.github.io/HandTrack3D/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentin0-fiz0l/HandTrack3D.git"
  },
  "bugs": {
    "url": "https://github.com/kentin0-fiz0l/HandTrack3D/issues"
  },
  "author": "Kentino",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "uwb:mock": "cd tools/uwb-companion && npm install && npm start"
  },
  "dependencies": {
    "@handtrack3d/core": "workspace:*",
    "@handtrack3d/rapier": "workspace:*",
    "@handtrack3d/react": "workspace:*",
    "@handtrack3d/three": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
