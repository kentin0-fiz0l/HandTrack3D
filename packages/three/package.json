{
  "name": "@handtrack3d/three",
  "version": "0.1.0-alpha.0",
  "description": "Three.js integration for hand tracking with MediaPipe and React Three Fiber",
  "keywords": [
    "three",
    "threejs",
    "react-three-fiber",
    "hand-tracking",
    "mediapipe",
    "gestures",
    "webgl",
    "3d"
  ],
  "author": "Kentino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kentin0-fiz0l/HandTrack3D.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/kentin0-fiz0l/HandTrack3D/tree/main/packages/three#readme",
  "bugs": {
    "url": "https://github.com/kentin0-fiz0l/HandTrack3D/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external three --external @react-three/fiber --external react --external react-dom",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external three --external @react-three/fiber --external react --external react-dom",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@handtrack3d/core": "workspace:*",
    "@handtrack3d/react": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.180.0",
    "tsup": "^8.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
